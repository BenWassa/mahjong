{
  "name": "mahjong",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "app": "npm --prefix app run dev",
    "app:phone": "npm --prefix app run phone",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "check:all": "npm run check && npm run check:app",
    "check:app": "npm --prefix app run check",
    "gate": "vitest run tests/gate",
    "lint": "eslint .",
    "qa": "npm --prefix app run qa",
    "sim": "tsx src/sim/run.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
