{
  "name": "mahjong",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "lint": "eslint .",
    "test": "vitest",
    "test:contracts": "vitest run tests/contracts tests/engine/invariants.test.ts tests/engine/mechanical-contracts.test.ts",
    "test:run": "vitest run",
    "test:simulation": "vitest run tests/simulation/seeded-simulation.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
