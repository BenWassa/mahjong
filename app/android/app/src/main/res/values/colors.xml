<?xml version="1.0" encoding="utf-8"?>
<!--
  Not part of the default Capacitor Android template (which references these
  names without defining them). Values match the table's own palette
  (app/src/styles/tokens.css, DESIGN.md §7) rather than Capacitor's stock
  blue, so the launcher theme, status bar and splash agree with the felt the
  app actually draws instead of flashing a different world first (#11).
-->
<resources>
    <color name="colorPrimary">#0E2620</color>
    <color name="colorPrimaryDark">#0A1A15</color>
    <color name="colorAccent">#B08D3F</color>
</resources>
